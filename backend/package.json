{
  "name": "xcarbon-backend",
  "version": "1.0.0",
  "description": "Carbon credits backend with compliance anchoring",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "db:migrate": "node --loader tsx src/db/migrate.ts",
    "db:seed": "node --loader tsx src/db/seed.ts",
    "sync:carbonmark": "node --loader tsx src/services/sync/carbonmark-sync.ts",
    "sync:alliedoffsets": "node --loader tsx src/services/sync/alliedoffsets-sync.ts",
    "lint": "eslint src",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:deploy": "hardhat run scripts/deploy.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.685.0",
    "@aws-sdk/client-s3": "^3.685.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@openzeppelin/contracts": "^5.1.0",
    "axios": "^1.7.9",
    "bullmq": "^5.23.5",
    "ethers": "^6.13.4",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "json-canonicalize": "^1.0.6",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "eslint": "^9.15.0",
    "hardhat": "^2.22.18",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

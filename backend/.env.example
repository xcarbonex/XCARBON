# Database
DATABASE_URL=postgresql://user:password@localhost:5432/xcarbon
DATABASE_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379

# Carbonmark API
CARBONMARK_API_URL=https://v17.api.carbonmark.com
CARBONMARK_API_KEY=
CARBONMARK_TEST_MODE=true

# AlliedOffsets API
ALLIEDOFFSETS_API_URL=https://api.alliedoffsets.com
ALLIEDOFFSETS_API_KEY=

# EVM Chain
CHAIN_RPC_URL=http://localhost:8545
CHAIN_ID=1337
COMPLIANCE_ANCHOR_ADDRESS=
PROJECT_DIRECTORY_ADDRESS=
TOKEN_STATUS_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# Evidence Storage
EVIDENCE_STORE_TYPE=s3  # s3 | ipfs | local
AWS_REGION=us-east-1
AWS_S3_BUCKET=xcarbon-evidence
AWS_KMS_KEY_ID=

# IPFS (optional)
IPFS_API_URL=https://ipfs.infura.io:5001
IPFS_GATEWAY_URL=https://ipfs.io

# API
API_PORT=3000
API_HOST=0.0.0.0
API_RATE_LIMIT=100
JWT_SECRET=

# Monitoring
LOG_LEVEL=info
SENTRY_DSN=

# Compliance
SANCTIONS_LIST_UPDATE_INTERVAL=3600000
KYC_PROVIDER=
TRAVEL_RULE_PROTOCOL=trisa

# Sync
SYNC_CARBONMARK_INTERVAL=300000
SYNC_ALLIEDOFFSETS_INTERVAL=3600000
